# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=iot_testbench

# JWT: APP_SECRET firma los tokens y JWT_SECRET los verifica en los guards.
# Deben tener el mismo valor.
APP_SECRET=change-me
JWT_SECRET=change-me

# Broker MQTT (por ejemplo, Mosquitto en local)
MQTT_URL=mqtt://localhost:1883
